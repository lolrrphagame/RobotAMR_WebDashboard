# COPY outside the repository to ~/.config/pbl4/lan.env, chmod 600; edit every placeholder.
# No shell execution or ${...} expansion. Absolute paths only; no credentials in Git.
APP_MODE=lan
LAN_HOST=amr.home.arpa
LAN_BIND_IP=192.168.1.100
HTTPS_PORT=8443
BACKEND_PORT=8001
ALLOWED_HOSTS=amr.home.arpa
ALLOWED_ORIGINS=https://amr.home.arpa:8443
ACCOUNT_STORE_PATH=/home/YOUR_USER/.config/pbl4/accounts.json
# Existing OPERATOR_PASSWORD_HASH may be retained here for explicit migration only.
# It no longer enables a fallback account. Use app.accounts to provision users.
TLS_MODE=internal
LAN_STATE_DIR=/home/YOUR_USER/.config/pbl4/lan-runtime
CADDY_BIN=/home/YOUR_USER/Projects/PBL4_Dashboard/.tools/caddy
# Optional explicit existing data paths. Omit to preserve backend/data defaults.
# MISSION_DB_PATH=/absolute/path/to/missions.sqlite3
# ROBOT_CONFIG_PATH=/absolute/path/to/robot-config.json
# For your own trusted certificate instead of Caddy's private CA:
# TLS_MODE=provided
# TLS_CERT_FILE=/absolute/private/path/fullchain.pem
# TLS_KEY_FILE=/absolute/private/path/key.pem
